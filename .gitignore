# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which carries no secrets and documents the vars
# a deploy needs (slot mode, Meta CAPI token, Google Calendar, GA).
!.env.example
*.json
!package*.json
!tsconfig.json
!jsconfig.json
!components.json

# vercel
.vercel

# zip archives & deployment bundles
*.zip
analytics_store.json

# typescript
*.tsbuildinfo
next-env.d.ts
