# Google Analytics 4 Measurement ID & Property ID (for /analytics dashboard API)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
GA_PROPERTY_ID=123456789
NEXT_PUBLIC_ANALYTICS_PIN=2026

# Google Calendar API Integration (Service Account)
# Obtain these from Google Cloud Console -> IAM & Admin -> Service Accounts -> Keys
GOOGLE_CLIENT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyHere\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=your-calendar-id@gmail.com
TIMEZONE=America/Toronto

# Booking slots
# "hourly" -> Mon-Fri 8, 9, 10, 11, 1, 2, 3, 4 (no noon); block what you don't
#             want directly in Google Calendar.
# "fixed"  -> only the four core slots (8, 10, 1, 3).
# Saturday is mornings only (8, 9, 10, 11) in both modes. Sunday is closed.
NEXT_PUBLIC_SLOT_MODE=hourly

# Meta Pixel + Conversions API
# The pixel alone loses conversions to ad blockers and Safari/ITP, so every
# Lead/Schedule is also sent server-side with a shared event_id for dedup.
# Token: Events Manager -> Settings -> Conversions API -> Generate access token
NEXT_PUBLIC_META_PIXEL_ID=1991419668160970
META_CAPI_ACCESS_TOKEN=
# Optional: Events Manager -> Test Events -> copy the code to verify the setup.
# Leave empty in production or events won't count as real conversions.
META_CAPI_TEST_EVENT_CODE=
